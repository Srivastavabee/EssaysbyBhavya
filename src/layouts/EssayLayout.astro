---
import BaseLayout from './BaseLayout.astro';
import Lenses from '../components/Lenses.astro';
import { formatEditorialDate, formatISODate } from '../lib/date';
import { subjectSlugFromTag } from '../lib/subjects';
import type { CollectionEntry } from 'astro:content';

interface Props {
  essay: CollectionEntry<'essays'>;
}

const { essay } = Astro.props;
const { title, excerpt, date, updated, tags, genes, flow, weave, origin, lenses } = essay.data;

// A timeline from a single point to an awakened being, drawn left to right.
const cells = [[0, 0]].concat(
  [0, 1, 2, 3, 4, 5].map((k) => [6.6 * Math.cos((k * Math.PI) / 3), 6.6 * Math.sin((k * Math.PI) / 3)])
);
const person = 'M0 -12 V8 M-9 -6 H9 M0 8 L-6 22 M0 8 L6 22';

// A short strand of mRNA, read three letters at a time (shown only when `genes: true`).
const codons = [
  ['AUG', 'Met'], ['CUG', 'Leu'], ['GUU', 'Val'], ['AAA', 'Lys'],
  ['CGU', 'Arg'], ['UAC', 'Tyr'], ['GGC', 'Gly'], ['GCU', 'Ala'],
  ['UUC', 'Phe'], ['AAG', 'Lys'], ['CAU', 'His'], ['UGA', 'Stop'],
];

const primaryTag = tags[0];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: formatISODate(date),
  dateModified: updated ? formatISODate(updated) : formatISODate(date),
  keywords: tags.join(', '),
  author: {
    '@type': 'Person',
    name: "B's",
  },
  publisher: {
    '@type': 'Organization',
    name: "B's Journal",
  },
  mainEntityOfPage: new URL(`/essays/${essay.id}`, Astro.site).toString(),
};
---

<BaseLayout
  title={title}
  description={excerpt}
  type="article"
  publishedTime={formatISODate(date)}
  modifiedTime={updated ? formatISODate(updated) : undefined}
  tags={tags}
  structuredData={articleSchema}
>
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>
  <article class="essay">
    <header class="essay-header container">
      {primaryTag && (
        <p class="essay-category">
          <a href={`/subjects/${subjectSlugFromTag(primaryTag)}`}>{primaryTag}</a>
          {tags.length > 1 && <span> / {tags.slice(1).join(' · ')}</span>}
        </p>
      )}
      <h1 class="essay-title">{title}</h1>
      <p class="essay-standfirst">{excerpt}</p>
      <p class="essay-date">
        <time datetime={formatISODate(date)}>{formatEditorialDate(date)}</time>
      </p>
      {flow && (
        <div class="evo" aria-hidden="true">
          <p class="codons-label">from a point to awakening</p>
          <svg width="340" height="72" viewBox="0 0 340 72" fill="none" stroke="#b7a6c8" stroke-width="1.1" stroke-linecap="round" style="display:block;max-width:100%;height:auto;overflow:visible">
            <line x1="22" y1="34" x2="300" y2="34" stroke="#392b43" stroke-width="1" />
            <line x1="22" y1="34" x2="300" y2="34" pathLength="1" stroke="#c9a66b" stroke-width="1" stroke-dasharray="1" stroke-dashoffset="1">
              <animate attributeName="stroke-dashoffset" values="1;1;0;0;0" keyTimes="0;0.04;0.62;0.98;1" dur="14s" repeatCount="indefinite" />
              <animate attributeName="opacity" values="1;1;1;0;1" keyTimes="0;0.9;0.94;0.98;1" dur="14s" repeatCount="indefinite" />
            </line>

            <g opacity="0"><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.02;0.04;0.94;0.98;1" dur="14s" repeatCount="indefinite" />
              <circle cx="22" cy="34" r="3.4" fill="#c9a66b" stroke="none" />
              <text x="22" y="62" font-family="'DM Mono', ui-monospace, Menlo, monospace" font-size="7.5" letter-spacing="1.2" text-anchor="middle" stroke="none" fill="#8f8199">POINT</text>
            </g>

            <g opacity="0"><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.15;0.19;0.94;0.98;1" dur="14s" repeatCount="indefinite" />
              <g transform="translate(84 34)" fill="#c9a66b" stroke="none">
                {cells.map(([x, y]) => <circle cx={x} cy={y} r="2.5" />)}
              </g>
              <text x="84" y="62" font-family="'DM Mono', ui-monospace, Menlo, monospace" font-size="7.5" letter-spacing="1.2" text-anchor="middle" stroke="none" fill="#8f8199">CELL</text>
            </g>

            <g opacity="0"><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.28;0.32;0.94;0.98;1" dur="14s" repeatCount="indefinite" />
              <g transform="translate(146 35) scale(0.55)"><circle cx="0" cy="-16" r="4.5" fill="#160d1e" /><path d={person} /></g>
              <text x="146" y="62" font-family="'DM Mono', ui-monospace, Menlo, monospace" font-size="7.5" letter-spacing="1.2" text-anchor="middle" stroke="none" fill="#8f8199">SELF</text>
            </g>

            <g opacity="0"><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.44;0.48;0.94;0.98;1" dur="14s" repeatCount="indefinite" />
              <path d="M205 29 L239 29 M205 29 Q222 14 239 29" stroke="#b7a6c8" stroke-width="0.8" opacity="0.7" />
              {[205, 222, 239].map((x) => (
                <g transform={`translate(${x} 35) scale(0.5)`}><circle cx="0" cy="-16" r="4.5" fill="#160d1e" /><path d={person} /></g>
              ))}
              <text x="222" y="62" font-family="'DM Mono', ui-monospace, Menlo, monospace" font-size="7.5" letter-spacing="1.2" text-anchor="middle" stroke="none" fill="#8f8199">SOCIETY</text>
            </g>

            <g opacity="0"><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.6;0.66;0.94;0.98;1" dur="14s" repeatCount="indefinite" />
              <circle cx="300" cy="34" r="23" stroke="#c9a66b" stroke-width="0.6" opacity="0.4">
                <animate attributeName="r" values="14;14;24;21;24;21;24" keyTimes="0;0.62;0.74;0.82;0.88;0.92;1" dur="14s" repeatCount="indefinite" />
              </circle>
              <circle cx="300" cy="25" r="7" stroke="#c9a66b" stroke-width="0.9" />
              {[0, 1, 2, 3, 4, 5, 6, 7].map((k) => (
                <line stroke="#c9a66b" stroke-width="0.8"
                  x1={300 + 9.5 * Math.cos((k * Math.PI) / 4)} y1={25 + 9.5 * Math.sin((k * Math.PI) / 4)}
                  x2={300 + 13 * Math.cos((k * Math.PI) / 4)} y2={25 + 13 * Math.sin((k * Math.PI) / 4)}>
                  <animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite" />
                </line>
              ))}
              <g transform="translate(300 35) scale(0.55)" stroke="#e6e1e8"><circle cx="0" cy="-16" r="4.5" fill="#160d1e" /><path d={person} /></g>
              <text x="300" y="62" font-family="'DM Mono', ui-monospace, Menlo, monospace" font-size="7.5" letter-spacing="1.2" text-anchor="middle" stroke="none" fill="#c9a66b">AWAKENING</text>
            </g>

            <circle cx="22" cy="34" r="3.4" fill="#e9cf9a" stroke="none" opacity="0">
              <animate attributeName="cx" values="22;22;300;300" keyTimes="0;0.04;0.62;1" dur="14s" repeatCount="indefinite" />
              <animate attributeName="opacity" values="0;1;1;0;0" keyTimes="0;0.04;0.62;0.66;1" dur="14s" repeatCount="indefinite" />
            </circle>
          </svg>
        </div>
      )}
      {weave && (
        <div class="evo" aria-hidden="true">
          <p class="codons-label">between the cell and the sentence</p>
          <svg width="340" height="72" viewBox="0 0 340 72" fill="none" stroke="#c9a66b" stroke-width="1" stroke-linecap="round" style="display:block;max-width:100%;height:auto;overflow:visible">
            <circle cx="26" cy="38" r="13" stroke="#b7a6c8" stroke-width="0.9">
              <animate attributeName="r" values="13;14.5;13" dur="4s" repeatCount="indefinite" />
            </circle>
            <circle cx="26" cy="38" r="4" fill="#c9a66b" stroke="none">
              <animate attributeName="opacity" values="1;0.5;1" dur="4s" repeatCount="indefinite" />
            </circle>
            <path d="M52 38 q20 -15 40 0 t40 0 t40 0 t40 0" stroke="#c9a66b" stroke-width="1" pathLength="1" stroke-dasharray="1" stroke-dashoffset="0">
              <animate attributeName="d" values="M52 38 q20 -15 40 0 t40 0 t40 0 t40 0;M52 38 q20 15 40 0 t40 0 t40 0 t40 0;M52 38 q20 -15 40 0 t40 0 t40 0 t40 0" dur="6s" repeatCount="indefinite" />
            </path>
            <g>
              <animate attributeName="opacity" values="1;1;0;0" keyTimes="0;0.94;0.98;1" dur="12s" repeatCount="indefinite" />
              <circle cx="238" cy="50" r="2.2" fill="#e9cf9a" stroke="none" opacity="0">
                <animate attributeName="opacity" values="0;0;1;1" keyTimes="0;0.340;0.370;1" dur="12s" repeatCount="indefinite" />
                <animate attributeName="r" values="2.2;3.2;2.2" dur="3s" repeatCount="indefinite" />
              </circle>
              <circle cx="254" cy="27" r="2.2" fill="#e9cf9a" stroke="none" opacity="0">
                <animate attributeName="opacity" values="0;0;1;1" keyTimes="0;0.425;0.455;1" dur="12s" repeatCount="indefinite" />
                <animate attributeName="r" values="2.2;3.2;2.2" dur="3s" repeatCount="indefinite" />
              </circle>
              <line x1="238" y1="50" x2="254" y2="27" pathLength="1" stroke="#c9a66b" stroke-width="0.8" stroke-dasharray="1" stroke-dashoffset="1">
                <animate attributeName="stroke-dashoffset" values="1;1;0;0" keyTimes="0;0.385;0.425;1" dur="12s" repeatCount="indefinite" />
              </line>
              <circle cx="274" cy="40" r="2.2" fill="#e9cf9a" stroke="none" opacity="0">
                <animate attributeName="opacity" values="0;0;1;1" keyTimes="0;0.510;0.540;1" dur="12s" repeatCount="indefinite" />
                <animate attributeName="r" values="2.2;3.2;2.2" dur="3s" repeatCount="indefinite" />
              </circle>
              <line x1="254" y1="27" x2="274" y2="40" pathLength="1" stroke="#c9a66b" stroke-width="0.8" stroke-dasharray="1" stroke-dashoffset="1">
                <animate attributeName="stroke-dashoffset" values="1;1;0;0" keyTimes="0;0.470;0.510;1" dur="12s" repeatCount="indefinite" />
              </line>
              <circle cx="292" cy="18" r="2.2" fill="#e9cf9a" stroke="none" opacity="0">
                <animate attributeName="opacity" values="0;0;1;1" keyTimes="0;0.595;0.625;1" dur="12s" repeatCount="indefinite" />
                <animate attributeName="r" values="2.2;3.2;2.2" dur="3s" repeatCount="indefinite" />
              </circle>
              <line x1="274" y1="40" x2="292" y2="18" pathLength="1" stroke="#c9a66b" stroke-width="0.8" stroke-dasharray="1" stroke-dashoffset="1">
                <animate attributeName="stroke-dashoffset" values="1;1;0;0" keyTimes="0;0.555;0.595;1" dur="12s" repeatCount="indefinite" />
              </line>
              <circle cx="312" cy="31" r="2.2" fill="#e9cf9a" stroke="none" opacity="0">
                <animate attributeName="opacity" values="0;0;1;1" keyTimes="0;0.680;0.710;1" dur="12s" repeatCount="indefinite" />
                <animate attributeName="r" values="2.2;3.2;2.2" dur="3s" repeatCount="indefinite" />
              </circle>
              <line x1="292" y1="18" x2="312" y2="31" pathLength="1" stroke="#c9a66b" stroke-width="0.8" stroke-dasharray="1" stroke-dashoffset="1">
                <animate attributeName="stroke-dashoffset" values="1;1;0;0" keyTimes="0;0.640;0.680;1" dur="12s" repeatCount="indefinite" />
              </line>
              <circle cx="324" cy="54" r="2.2" fill="#e9cf9a" stroke="none" opacity="0">
                <animate attributeName="opacity" values="0;0;1;1" keyTimes="0;0.765;0.795;1" dur="12s" repeatCount="indefinite" />
                <animate attributeName="r" values="2.2;3.2;2.2" dur="3s" repeatCount="indefinite" />
              </circle>
              <line x1="312" y1="31" x2="324" y2="54" pathLength="1" stroke="#c9a66b" stroke-width="0.8" stroke-dasharray="1" stroke-dashoffset="1">
                <animate attributeName="stroke-dashoffset" values="1;1;0;0" keyTimes="0;0.725;0.765;1" dur="12s" repeatCount="indefinite" />
              </line>
            </g>
            <text x="26" y="66" font-family="'DM Mono', ui-monospace, Menlo, monospace" font-size="7.5" letter-spacing="1.2" text-anchor="middle" stroke="none" fill="#8f8199">CELL</text>
            <text x="282" y="68" font-family="'DM Mono', ui-monospace, Menlo, monospace" font-size="7.5" letter-spacing="1.2" text-anchor="middle" stroke="none" fill="#8f8199" fill="#c9a66b">STORY</text>
          </svg>
        </div>
      )}
      {origin && (
        <div class="evo origin-inline" aria-hidden="true">
          <p class="codons-label">before anyone was there</p>
          <svg width="340" height="72" viewBox="0 0 340 72" fill="none" stroke-linecap="round" style="display:block;max-width:100%;height:auto;overflow:visible">
            <defs>
              <radialGradient id="ol-m" cx="50%" cy="45%" r="60%">
                <stop offset="0" stop-color="#f0d79a" stop-opacity="0.95" />
                <stop offset="0.7" stop-color="#c9a66b" stop-opacity="0.55" />
                <stop offset="1" stop-color="#8a6a3a" stop-opacity="0.3" />
              </radialGradient>
              <clipPath id="ol-c"><circle cx="60" cy="36" r="22" /></clipPath>
            </defs>
            <g opacity="1">
              <animate attributeName="opacity" values="1;1;0;0" keyTimes="0;0.94;0.985;1" dur="16s" repeatCount="indefinite" />
              <circle cx="60" cy="36" r="22" fill="url(#ol-m)" stroke="none" opacity="0">
                <animate attributeName="opacity" values="0;1;0.75;1;0.5;0;0" keyTimes="0;0.03;0.10;0.17;0.25;0.36;1" dur="16s" repeatCount="indefinite" />
              </circle>
              <g clip-path="url(#ol-c)" opacity="0">
                <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.22;0.28;0.5;0.56;1" dur="16s" repeatCount="indefinite" />
                <line x1="44" y1="10" x2="44" y2="16" stroke="#b7a6c8" stroke-width="0.9">
                  <animateTransform attributeName="transform" type="translate" values="0 -6;0 50" dur="1.1s" begin="-0.00s" repeatCount="indefinite" />
                </line>
                <line x1="52" y1="10" x2="52" y2="16" stroke="#b7a6c8" stroke-width="0.9">
                  <animateTransform attributeName="transform" type="translate" values="0 -6;0 50" dur="1.1s" begin="-0.23s" repeatCount="indefinite" />
                </line>
                <line x1="60" y1="10" x2="60" y2="16" stroke="#b7a6c8" stroke-width="0.9">
                  <animateTransform attributeName="transform" type="translate" values="0 -6;0 50" dur="1.1s" begin="-0.46s" repeatCount="indefinite" />
                </line>
                <line x1="68" y1="10" x2="68" y2="16" stroke="#b7a6c8" stroke-width="0.9">
                  <animateTransform attributeName="transform" type="translate" values="0 -6;0 50" dur="1.1s" begin="-0.69s" repeatCount="indefinite" />
                </line>
                <line x1="76" y1="10" x2="76" y2="16" stroke="#b7a6c8" stroke-width="0.9">
                  <animateTransform attributeName="transform" type="translate" values="0 -6;0 50" dur="1.1s" begin="-0.92s" repeatCount="indefinite" />
                </line>
              </g>
              <g clip-path="url(#ol-c)" opacity="0">
                <animate attributeName="opacity" values="0;0;1;1" keyTimes="0;0.48;0.58;1" dur="16s" repeatCount="indefinite" />
                <path d="M36 42 q6 -4 12 0 t12 0 t12 0 t12 0 V62 H36 Z" fill="#b7a6c8" fill-opacity="0.28" stroke="#b7a6c8" stroke-width="0.9">
                  <animate attributeName="d" values="M36 42 q6 -4 12 0 t12 0 t12 0 t12 0 V62 H36 Z;M36 42 q6 4 12 0 t12 0 t12 0 t12 0 V62 H36 Z;M36 42 q6 -4 12 0 t12 0 t12 0 t12 0 V62 H36 Z" dur="5s" repeatCount="indefinite" />
                </path>
              </g>
              <g opacity="0">
                <animate attributeName="opacity" values="0;0;1;1" keyTimes="0;0.74;0.78;1" dur="16s" repeatCount="indefinite" />
                <circle cx="60" cy="52" r="2" fill="#e9cf9a" stroke="none">
                  <animate attributeName="r" values="2;3.4;2" dur="2s" repeatCount="indefinite" />
                </circle>
                <circle cx="60" cy="52" r="3" stroke="#c9a66b" stroke-width="0.7" opacity="0.6">
                  <animate attributeName="r" values="3;16" dur="2.6s" repeatCount="indefinite" />
                  <animate attributeName="opacity" values="0.7;0" dur="2.6s" repeatCount="indefinite" />
                </circle>
              </g>
              <circle cx="60" cy="36" r="22" stroke="#c9a66b" stroke-width="1">
                <animate attributeName="stroke" values="#c9a66b;#c9a66b;#8f8199;#b7a6c8;#b7a6c8" keyTimes="0;0.2;0.34;0.55;1" dur="16s" repeatCount="indefinite" />
              </circle>
            <g opacity="0"><animate attributeName="opacity" values="1;1;0;0" keyTimes="0;0.220;0.250;1" dur="16s" repeatCount="indefinite" />
              <text x="104" y="30" font-family="'DM Mono', ui-monospace, Menlo, monospace" stroke="none" font-size="7.5" letter-spacing="1.2" fill="#8f8199">4.5 BILLION YEARS AGO</text>
              <text x="104" y="48" font-family="'Source Serif 4', Georgia, serif" font-style="italic" font-size="15" stroke="none" fill="#e6e1e8">A molten world</text>
            </g>
            <g opacity="0"><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.250;0.280;0.470;0.500;1" dur="16s" repeatCount="indefinite" />
              <text x="104" y="30" font-family="'DM Mono', ui-monospace, Menlo, monospace" stroke="none" font-size="7.5" letter-spacing="1.2" fill="#8f8199">4.4 BILLION</text>
              <text x="104" y="48" font-family="'Source Serif 4', Georgia, serif" font-style="italic" font-size="15" stroke="none" fill="#e6e1e8">Rain, for ages</text>
            </g>
            <g opacity="0"><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.500;0.530;0.720;0.750;1" dur="16s" repeatCount="indefinite" />
              <text x="104" y="30" font-family="'DM Mono', ui-monospace, Menlo, monospace" stroke="none" font-size="7.5" letter-spacing="1.2" fill="#8f8199">4.3 BILLION</text>
              <text x="104" y="48" font-family="'Source Serif 4', Georgia, serif" font-style="italic" font-size="15" stroke="none" fill="#e6e1e8">The first oceans</text>
            </g>
            <g opacity="0"><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.750;0.780;0.920;0.950;1" dur="16s" repeatCount="indefinite" />
              <text x="104" y="30" font-family="'DM Mono', ui-monospace, Menlo, monospace" stroke="none" font-size="7.5" letter-spacing="1.2" fill="#8f8199">3.5 BILLION OR EARLIER</text>
              <text x="104" y="48" font-family="'Source Serif 4', Georgia, serif" font-style="italic" font-size="15" stroke="none" fill="#e9cf9a">A spark</text>
            </g>
            </g>
          </svg>
        </div>
      )}
      {origin && (
        <aside class="origin-big" aria-hidden="true">
          <svg width="260" height="330" viewBox="0 0 260 330" fill="none" stroke-linecap="round" style="display:block;overflow:visible">
            <defs>
              <radialGradient id="ol2-m" cx="50%" cy="42%" r="62%">
                <stop offset="0" stop-color="#f6e2b0" stop-opacity="0.95" />
                <stop offset="0.65" stop-color="#c9a66b" stop-opacity="0.6" />
                <stop offset="1" stop-color="#8a6a3a" stop-opacity="0.3" />
              </radialGradient>
              <filter id="ol2-g" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9" /></filter>
              <clipPath id="ol2-c"><circle cx="130" cy="120" r="84" /></clipPath>
            </defs>
        <circle cx="90" cy="44" r="0.9" fill="#b7a6c8" stroke="none" opacity="0.2">
          <animate attributeName="opacity" values="0.1;0.8;0.1" dur="4.1s" begin="-0.3s" repeatCount="indefinite" />
        </circle>
        <circle cx="145" cy="30" r="0.9" fill="#b7a6c8" stroke="none" opacity="0.2">
          <animate attributeName="opacity" values="0.1;0.8;0.1" dur="4.0s" begin="-3.6s" repeatCount="indefinite" />
        </circle>
        <circle cx="62" cy="15" r="0.7" fill="#b7a6c8" stroke="none" opacity="0.2">
          <animate attributeName="opacity" values="0.1;0.8;0.1" dur="3.6s" begin="-0.3s" repeatCount="indefinite" />
        </circle>
        <circle cx="31" cy="147" r="0.9" fill="#b7a6c8" stroke="none" opacity="0.2">
          <animate attributeName="opacity" values="0.1;0.8;0.1" dur="2.6s" begin="-2.3s" repeatCount="indefinite" />
        </circle>
        <circle cx="250" cy="63" r="1.2" fill="#b7a6c8" stroke="none" opacity="0.2">
          <animate attributeName="opacity" values="0.1;0.8;0.1" dur="4.1s" begin="-3.8s" repeatCount="indefinite" />
        </circle>
        <circle cx="155" cy="155" r="0.9" fill="#b7a6c8" stroke="none" opacity="0.2">
          <animate attributeName="opacity" values="0.1;0.8;0.1" dur="2.6s" begin="-0.9s" repeatCount="indefinite" />
        </circle>
        <circle cx="150" cy="225" r="0.7" fill="#b7a6c8" stroke="none" opacity="0.2">
          <animate attributeName="opacity" values="0.1;0.8;0.1" dur="3.2s" begin="-0.6s" repeatCount="indefinite" />
        </circle>
        <circle cx="38" cy="152" r="0.9" fill="#b7a6c8" stroke="none" opacity="0.2">
          <animate attributeName="opacity" values="0.1;0.8;0.1" dur="3.9s" begin="-2.7s" repeatCount="indefinite" />
        </circle>
        <circle cx="34" cy="154" r="1.2" fill="#b7a6c8" stroke="none" opacity="0.2">
