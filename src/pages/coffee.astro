---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Coffee?"
  description="A quiet corner of B's Journal — for a conversation over coffee."
>
  <section class="coffee">
    <div class="container coffee-inner">
      <p class="eyebrow">Pull up a chair</p>
      <h1 class="coffee-title">Coffee?</h1>

      <div class="steam" aria-hidden="true"><span></span><span></span><span></span></div>

      <figure class="quote">
        <blockquote>
          <p>Coffee is the small ritual that lets the mind arrive before the day does.<sup class="tm" aria-label="trademark">&trade;</sup></p>
        </blockquote>
        <figcaption>— Bhavya</figcaption>
      </figure>

      <div class="ornament" role="presentation"><span class="ornament-mark">&#9670;</span></div>

      <p class="reach">Find me</p>
      <ul class="contacts">
        <li><a class="row" href="mailto:bhavyasrivastava18@gmail.com"><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/></svg></span><span class="name">Email</span><span class="handle">bhavyasrivastava18@gmail.com</span><span class="go" aria-hidden="true">&rarr;</span></a></li>
        <li>
          <div class="row">
            <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/></svg></span>
            <span class="name">Instagram</span>
            <span class="handles">
              <a href="https://www.instagram.com/jinxed0_0panda/" target="_blank" rel="noopener noreferrer" aria-label="Instagram, jinxed0_0panda">@jinxed0_0panda</a>
              <a href="https://www.instagram.com/byondscripts/" target="_blank" rel="noopener noreferrer" aria-label="Instagram, byondscripts">@byondscripts</a>
            </span>
            <span class="go" aria-hidden="true"></span>
          </div>
        </li>
        <li><a class="row" href="https://x.com/bhavyeah__" target="_blank" rel="noopener noreferrer"><span class="icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></span><span class="name">X</span><span class="handle">@bhavyeah__</span><span class="go" aria-hidden="true">&rarr;</span></a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .coffee { padding: 4rem 0 5rem; }

  .coffee-inner {
    max-width: 38rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .coffee-title {
    font-size: clamp(2.6rem, 7vw, 4rem);
    margin: 0.9rem 0 1.25rem;
  }

  .steam { display: flex; gap: 0.7rem; height: 2.6rem; margin-bottom: 1.5rem; }
  .steam span {
    width: 1px;
    height: 100%;
    background: linear-gradient(to top, var(--color-gold), transparent);
    opacity: 0;
    transform-origin: bottom;
    animation: steam 4.5s ease-in-out infinite;
  }
  .steam span:nth-child(2) { animation-delay: 1.2s; height: 80%; }
  .steam span:nth-child(3) { animation-delay: 2.4s; }

  @keyframes steam {
    0%   { opacity: 0; transform: translateY(8px) scaleY(0.6); }
    40%  { opacity: 0.7; }
    100% { opacity: 0; transform: translateY(-10px) scaleY(1.1); }
  }

  .quote { margin: 0 0 2.5rem; }

  .quote blockquote { margin: 0; padding: 0; border: 0; }

  .quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    line-height: 1.4;
    color: var(--color-text);
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .tm {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.5em;
    letter-spacing: 0.05em;
    color: var(--color-gold);
    margin-left: 0.15em;
    vertical-align: super;
  }

  .reach {
    margin: 2.25rem 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    text-align: left;
    border-top: 1px solid var(--color-rule);
  }
  .contacts li { border-bottom: 1px solid var(--color-rule); }

  .row {
    display: grid;
    grid-template-columns: 2.25rem 6.5rem 1fr 1.25rem;
    align-items: center;
    gap: 0 0.75rem;
    padding: 1.15rem 0.25rem;
    text-decoration: none;
    color: var(--color-text);
    transition: color 0.3s ease, padding-left 0.3s ease;
  }
  .icon { display: grid; place-items: center; color: var(--color-accent); transition: color 0.3s ease; }
  .icon svg { width: 1.2rem; height: 1.2rem; }
  .name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.2;
  }
  .handle {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .go {
    text-align: right;
    color: var(--color-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.3s ease, transform 0.3s ease, color 0.3s ease;
  }
  .handles {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem 3rem;
  }
  .handles a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .handles a:hover, .handles a:focus-visible { color: var(--color-gold); border-color: var(--color-gold); }
  a.row:hover, a.row:focus-visible { padding-left: 0.6rem; }
  a.row:hover .icon, a.row:focus-visible .icon,
  a.row:hover .go, a.row:focus-visible .go { color: var(--color-gold); }
  a.row:hover .go, a.row:focus-visible .go { opacity: 1; transform: none; }
  a.row:hover .handle, a.row:focus-visible .handle { color: var(--color-text); }

  @media (max-width: 520px) {
    .row { grid-template-columns: 2rem 1fr 1rem; grid-template-areas: "i n g" "i h g"; gap: 0.15rem 0.6rem; }
    .icon { grid-area: i; }
    .name { grid-area: n; }
    .handle, .handles { grid-area: h; text-align: left; justify-content: flex-start; }
    .go { grid-area: g; opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .steam span { animation: none; opacity: 0.4; }
  }
</style>
