<style>
  .evo { margin-top: 2rem; }

  .codons { margin-top: 2rem; }

  .codons-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: var(--color-muted);
    margin: 0 0 0.6rem;
    opacity: 0.8;
  }

  .codons-row { display: flex; flex-wrap: nowrap; gap: 0 1.1rem; }

  .codon {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    color: var(--color-muted);
    opacity: 0.55;
    animation: read-codon 10s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.6s);
  }

  .bases {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.18em;
  }

  .aa {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @keyframes read-codon {
    0%, 14%, 100% { color: var(--color-muted); opacity: 0.55; text-shadow: none; }
    5% { color: var(--color-gold); opacity: 1; text-shadow: 0 0 10px rgba(201, 166, 107, 0.55); }
  }

  @media (max-width: 600px) {
    .codon:nth-child(n + 8) { display: none; }
    .codons-row { gap: 0 0.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .codon { animation: none; opacity: 0.7; }
  }

  .essay-header {
    max-width: var(--measure);
    margin-left: 0;
    margin-right: auto;
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }

  .essay-category {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 1.5rem;
  }

  .essay-category a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .essay-category a:hover,
  .essay-category a:focus-visible {
    border-color: var(--color-accent);
  }

  .essay-title {
    font-size: clamp(2rem, 6vw, 3.25rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .essay-standfirst {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 1.75rem;
  }

  .essay-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }

  .essay-rule {
    max-width: var(--measure);
    margin-left: 0;
    margin-right: auto;
  }

  .essay-content {
    max-width: var(--measure);
    margin-left: 0;
    margin-right: auto;
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .essay-footer {
    max-width: var(--measure);
    margin-left: 0;
    margin-right: auto;
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .essay-footer .rule {
    margin-bottom: 2rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-accent);
  }
</style>

<style is:global>
  .essay-content p {
    font-size: 1.0625rem;
    line-height: 1.85;
    margin: 0 0 1.6em;
  }

  .essay-content > p:first-of-type::first-letter {
    font-family: var(--font-display);
    font-size: 3.6em;
    line-height: 0.85;
    float: left;
    padding-right: 0.12em;
    padding-top: 0.04em;
    color: var(--color-accent);
    font-weight: 500;
  }

  .essay-content h2 {
    font-size: 1.65rem;
    margin: 2.75em 0 1em;
    color: var(--color-text);
  }

  .essay-content h3 {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
    font-size: 1.2rem;
    margin: 2.25em 0 0.85em;
    color: var(--color-text);
  }

  .essay-content a {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }

  .essay-content a:hover,
  .essay-content a:focus-visible {
    color: var(--color-accent);
  }

  .essay-content blockquote {
    margin: 2.25em 0;
    padding-left: 1.5em;
    border-left: 2px solid var(--color-rule);
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .essay-content blockquote p:last-child {
    margin-bottom: 0;
  }

  .essay-content ul,
  .essay-content ol {
    margin: 0 0 1.6em;
    padding-left: 1.4em;
    line-height: 1.85;
  }

  .essay-content li {
    margin-bottom: 0.5em;
  }

  .essay-content hr {
    border: none;
    text-align: center;
    margin: 3em 0;
  }

  .essay-content hr::before {
    content: '❧';
    color: var(--color-muted);
  }

  .essay-content img {
    margin: 2.5em auto;
    max-width: 100%;
  }

  .essay-content figure {
    margin: 2.5em 0;
  }

  .essay-content figcaption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    margin-top: 0.75em;
    text-align: center;
  }

  .essay-content code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-bg-secondary);
    padding: 0.15em 0.4em;
    border-radius: 2px;
  }

  .essay-content pre {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-rule);
    padding: 1.25em;
    overflow-x: auto;
    margin: 2em 0;
    line-height: 1.6;
  }

  .essay-content pre code {
    background: none;
    padding: 0;
  }
</style>

<style is:global>
  .origin-inline { display: none !important; }
  .origin-big { display: block; margin: 1.75rem 0 0.5rem; pointer-events: none; }
  .origin-big svg { width: 230px; height: auto; max-width: 100%; display: block; }
  @media (min-width: 1240px) {
    .origin-big {
      position: fixed;
      right: clamp(90px, 7vw, 150px);
      top: 50%;
      transform: translateY(-50%);
      width: 260px;
      margin: 0;
      z-index: 1;
    }
    .origin-big svg { width: 260px; }
  }
</style>
