<section class="masthead">
  <div class="container masthead-inner">
    <p class="kicker rise" style="--d:0.05s">Journal</p>
    <h1 class="wordmark rise" style="--d:0.2s">B's</h1>
    <p class="subtitle rise" style="--d:0.4s">
      Essays on biology, literature, <br class="subtitle-break" />
      and the cultural architecture <br class="subtitle-break" />
      of the human spirit.
    </p>
    <p class="thinking rise" style="--d:0.6s">
      <span class="thinking-label">Thinking about</span>
      <span class="cycler" aria-hidden="true"><span class="reel" data-reel><span>genes</span><span>grammar</span><span>gods</span><span>games</span><span>memory</span><span>migration</span><span>myth</span><span>meaning</span><span>genes</span></span></span><span class="sr-only">genes, grammar, gods, games, memory, migration, myth, meaning</span>
    </p>
  </div>
</section>

<style>
  .masthead {
    position: relative;
    overflow: hidden;
    padding: 5rem 0 4.5rem;
  }

  .masthead-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .rise {
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(4.5rem, 14vw, 8rem);
    line-height: 1;
    margin: 0.25rem 0 0.5rem;
    color: var(--color-text);
    background: linear-gradient(
      100deg,
      #e6e1e8 0%,
      #e6e1e8 38%,
      #f0dcae 48%,
      #c9a66b 54%,
      #e6e1e8 64%,
      #e6e1e8 100%
    );
    background-size: 260% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s both, sheen 9s ease-in-out 1.4s infinite;
  }

  @keyframes sheen {
    0% { background-position: 110% 0; }
    55%, 100% { background-position: -15% 0; }
  }

  .subtitle {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 30rem;
    margin: 0;
  }

  .thinking {
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cycler {
    display: inline-block;
    height: 1.7em;
    min-width: 8.5em;
    overflow: hidden;
    vertical-align: bottom;
    text-align: left;
    color: var(--color-gold);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 28%, #000 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 28%, #000 72%, transparent 100%);
  }

  .reel { display: block; will-change: transform; }
  .reel span { display: block; height: 1.7em; line-height: 1.7em; }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .subtitle-break { display: none; }

  @media (min-width: 560px) {
    .subtitle-break { display: inline; }
  }

  @media (min-width: 768px) {
    .masthead { padding: 7rem 0 5.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark {
      animation: none;
    }
  }
</style>

<script>
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  if (reel) {
    const total = reel.children.length - 1; // last word repeats the first, so the loop is seamless
    let i = 0;
    const step = () => {
      i += 1;
      reel.style.transition = 'transform 0.75s cubic-bezier(0.65, 0, 0.2, 1)';
      reel.style.transform = `translateY(-${i * 1.7}em)`;
      if (i === total) {
        setTimeout(() => {
          reel.style.transition = 'none';
          reel.style.transform = 'translateY(0)';
          i = 0;
        }, 800);
      }
    };
    setInterval(step, 2200);
  }
</script>
