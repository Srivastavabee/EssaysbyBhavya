---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EssayList from '../../components/EssayList.astro';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Essays"
  description="The complete archive of essays on biology, literature, religion, culture, and the human spirit."
>
  <header class="archive-header">
    <div class="container">
      <p class="eyebrow">Archive</p>
      <h1 class="archive-title">Essays</h1>
    </div>
  </header>

  <section class="container">
    <EssayList essays={essays} />
  </section>
</BaseLayout>

<style>
  .archive-header {
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }

  .archive-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin-top: 0.75rem;
  }
</style>
