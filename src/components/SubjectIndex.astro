---
import { getCollection } from 'astro:content';
import { subjects, subjectSlugFromTag } from '../lib/subjects';

const essays = await getCollection('essays', ({ data }) => !data.draft);
const counts = Object.fromEntries(
  subjects.map((s) => [
    s.slug,
    essays.filter((e) => e.data.tags.some((t) => subjectSlugFromTag(t) === s.slug)).length,
  ])
);
---

<ul class="subject-index" data-reveal>
  {subjects.map((subject) => (
    <li>
      <a href={`/subjects/${subject.slug}`} class="subject-link">
        <span class="subject-name">
          {subject.name}
          <span class="subject-count" aria-label={`${counts[subject.slug]} essays`}>{counts[subject.slug]}</span>
        </span>
        <span class="subject-descriptor">{subject.descriptor}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .subject-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-rule);
    border-left: 1px solid var(--color-rule);
  }

  @media (min-width: 640px) { .subject-index { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .subject-index { grid-template-columns: repeat(5, 1fr); } }

  .subject-link {
    display: block;
    text-decoration: none;
    padding: 1.75rem 1.5rem;
    border-right: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-text);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
  }

  .subject-link:hover,
  .subject-link:focus-visible {
    background-color: var(--color-bg-secondary);
    box-shadow: inset 0 -2px 0 var(--color-gold);
  }

  .subject-name {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .subject-count {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    letter-spacing: 0;
    color: var(--color-gold);
  }

  .subject-descriptor {
    display: block;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
</style>
