---
import { toRoman } from '../lib/roman';
import { formatYear } from '../lib/date';
import type { CollectionEntry } from 'astro:content';

interface Props {
  essays: CollectionEntry<'essays'>[];
  startIndex?: number;
}

const { essays, startIndex = 1 } = Astro.props;
---

<ol class="essay-list">
  {essays.map((essay, i) => (
    <li class="essay-item" data-reveal style={`--d:${Math.min(i,4)*0.08}s`}>
      <hr class="rule" />
      <a href={`/essays/${essay.id}`} class="essay-link">
        <span class="numeral" aria-hidden="true">{toRoman(startIndex + i)}</span>
        <span class="essay-body">
          <span class="essay-title">{essay.data.title}</span>
          <span class="essay-excerpt">{essay.data.excerpt}</span>
          <span class="essay-meta">
            <time datetime={essay.data.date.toISOString()}>{formatYear(essay.data.date)}</time>
            {essay.data.tags.length > 0 && (
              <span class="essay-tags"> · {essay.data.tags.join(', ')}</span>
            )}
          </span>
        </span>
      </a>
    </li>
  ))}
  <hr class="rule" />
</ol>

<style>
  .essay-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .essay-item {
    position: relative;
  }

  .rule {
    border: none;
    border-top: 1px solid var(--color-rule);
    margin: 0;
  }

  .essay-link {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1.25rem;
    align-items: baseline;
    text-decoration: none;
    color: var(--color-text);
    padding: 2rem 0;
    transition: color 0.2s ease;
  }

  .essay-link:hover .essay-title,
  .essay-link:focus-visible .essay-title {
    color: var(--color-text);
    background-size: 100% 1px;
  }

  .essay-link:hover .numeral,
  .essay-link:focus-visible .numeral {
    color: var(--color-gold);
    transform: translateX(3px);
  }

  .essay-link:hover .essay-body,
  .essay-link:focus-visible .essay-body {
    transform: translateX(6px);
  }

  .numeral {
    transition: color 0.3s ease, transform 0.3s ease;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .essay-body {
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .essay-title {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-text);
    align-self: flex-start;
    background: linear-gradient(var(--color-gold), var(--color-gold)) 0 100% / 0 1px no-repeat;
    padding-bottom: 0.15rem;
    transition: color 0.3s ease, background-size 0.45s ease;
  }

  .essay-excerpt {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 38rem;
  }

  .essay-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (min-width: 640px) {
    .essay-title {
      font-size: 1.75rem;
    }
  }
</style>
